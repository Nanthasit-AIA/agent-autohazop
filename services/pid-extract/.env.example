# ---- LLM (LiteLLM proxy is the primary path) ----
# Your project's proxy. The service appends /v1 if it is missing.
LITELLM_BASE_URL=https://scgc-llmproxy.scg.com
LITELLM_API_KEY=
# Model id exactly as the proxy's /v1/models lists it (e.g. gpt-5.5, gemini-3.5-flash,
# claude-opus-4-8). Display names containing spaces are not accepted.
EXTRACT_MODEL=gpt-5.5

# Deployment-level overrides. Set these to point at a different proxy or at
# api.openai.com without touching LITELLM_*.
LLM_BASE_URL=
LLM_API_KEY=
# Fallback only: used when no LiteLLM/LLM credential is set.
OPENAI_API_KEY=

# ---- storage: local | blob ----
STORAGE_BACKEND=local
LOCAL_STORE_DIR=data

# Only when STORAGE_BACKEND=blob. Inputs land in inputs/<job_id>/, results in results/.
BLOB_CONTAINER=pid-results
AZURE_STORAGE_CONNECTION_STRING=
# Leave the connection string empty and set this to use a managed identity instead.
AZURE_STORAGE_ACCOUNT=

# ---- service ----
ALLOWED_ORIGINS=*
PORT=8000
LOG_LEVEL=INFO
