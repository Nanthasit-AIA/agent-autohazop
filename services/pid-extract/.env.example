# Required. Read at request time, not at import time.
OPENAI_API_KEY=

# Optional. Unset -> api.openai.com. Point at a LiteLLM / OpenRouter proxy to switch providers.
LLM_BASE_URL=
EXTRACT_MODEL=gpt-5.1-2025-11-13

# local | blob
STORAGE_BACKEND=local
LOCAL_STORE_DIR=data

# Only when STORAGE_BACKEND=blob. Use the connection string, or leave it empty
# and set AZURE_STORAGE_ACCOUNT to authenticate with a managed identity.
BLOB_CONTAINER=pid-results
AZURE_STORAGE_CONNECTION_STRING=
AZURE_STORAGE_ACCOUNT=

# Comma-separated origins allowed to call this API. "*" for local dev.
ALLOWED_ORIGINS=*

PORT=8000
LOG_LEVEL=INFO
