# BUILD NEW .env FOR WORKING.
# Copy to .env. Read by docker compose, scripts/local-start.ps1 and backend/app.py.

# LiteLLM proxy - the primary path for P&ID extraction (and available to HAZOP).
LITELLM_BASE_URL=https://scgc-llmproxy.scg.com
LITELLM_API_KEY=
# Model ids exactly as the proxy lists them; shown in the UI picker, first is default.
LITELLM_MODELS=gpt-5.5,gemini-3.5-flash,claude-opus-4-8

# OpenAI direct ("Own API" in the picker). Leave the key empty and it is not offered.
# The HAZOP agent still defaults to this provider.
OPENAI_API_KEY=
OPENAI_MODELS=gpt-5.5-2026-04-23

HAZOP_VECTOR_STORE_ID=
LOG_LEVEL=INFO
