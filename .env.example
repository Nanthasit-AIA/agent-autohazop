# Copy to .env and fill in. Used by docker compose and by backend/app.py.

# LiteLLM proxy - the primary path for P&ID extraction.
LITELLM_BASE_URL=https://scgc-llmproxy.scg.com
LITELLM_API_KEY=
EXTRACT_MODEL=gpt-5.5

# Still used by the HAZOP agent in backend/, which calls OpenAI directly.
OPENAI_API_KEY=

LOG_LEVEL=INFO
